<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Leaf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Leaf"
    Title="Leaf">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar strip: app menu, tabs, then a draggable spacer; caption buttons are drawn by the system on the right. -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionSpacer" Width="140" />
            </Grid.ColumnDefinitions>

            <Button x:Name="AppMenuButton" Grid.Column="0" Margin="6,0,2,0" Padding="8,6" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    AccessKey="F" AutomationProperties.Name="Leaf menu"
                    ToolTipService.ToolTip="Menu (Alt+F)">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnAppMenuOpening">
                        <MenuFlyoutItem Text="Open…" Click="OnOpenClick">
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+O</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem x:Name="RecentMenu" Text="Open Recent">
                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>

                        <MenuFlyoutSeparator />

                        <!-- Printing lands in 0.3.0; the item stays visible so the gap is obvious rather than mysterious. -->
                        <MenuFlyoutItem x:Name="PrintMenuItem" Text="Print…" IsEnabled="False" Click="OnPrintClick">
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+P</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="PropertiesMenuItem" Text="Document Properties…" Click="OnPropertiesClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem x:Name="FullScreenMenuItem" Text="Full screen" Click="OnFullScreenClick">
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>F11</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem Text="Make Leaf the default PDF app…" Click="OnSetDefaultClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="About Leaf" Click="OnAboutClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE897;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <TabView x:Name="Tabs" Grid.Column="1" Margin="0,0,0,0"
                     VerticalAlignment="Bottom"
                     IsAddTabButtonVisible="True"
                     AddTabButtonClick="OnAddTabClick"
                     TabCloseRequested="OnTabCloseRequested"
                     SelectionChanged="OnTabSelectionChanged"
                     CanReorderTabs="True" CanDragTabs="False">
                <TabView.TabStripFooter>
                    <Grid x:Name="DragRegion" MinWidth="80" Height="40" Background="Transparent" />
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <!-- App-level notices get their own row so they never cover the viewer toolbar. -->
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" Margin="12,4,12,0" />

        <Grid x:Name="ContentHost" Grid.Row="2">
            <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Leaf" Style="{ThemeResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="A light, fast PDF reader." Style="{ThemeResource BodyTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.8" />
                <Button Content="Open a PDF  (Ctrl+O)" Click="OnOpenClick" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                <TextBlock Text="or drop a file anywhere in this window" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <ContentPresenter x:Name="TabContent" />

            <!-- Full screen: a one-off hint, dismissed by itself or by any of the exit keys. -->
            <InfoBar x:Name="FullScreenHint" IsOpen="False" IsClosable="True" Severity="Informational"
                     VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                     Title="Full screen"
                     Message="Press F11, Ctrl+L or Esc to leave. Move the pointer to the top edge for the toolbar." />
        </Grid>
    </Grid>
</Window>
