<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Leaf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Leaf"
    Title="Leaf">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar strip: app icon, tabs, then a draggable spacer; caption buttons are drawn by the system on the right. -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionSpacer" Width="140" />
            </Grid.ColumnDefinitions>

            <Button x:Name="AppMenuButton" Grid.Column="0" Margin="6,0,2,0" Padding="6" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Leaf menu">
                <Image x:Name="AppIcon" Width="16" Height="16" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem Text="Open…" Click="OnOpenClick">
                            <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+O</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Make Leaf the default PDF app…" Click="OnSetDefaultClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="About Leaf" Click="OnAboutClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <TabView x:Name="Tabs" Grid.Column="1" Margin="0,0,0,0"
                     VerticalAlignment="Bottom"
                     IsAddTabButtonVisible="True"
                     AddTabButtonClick="OnAddTabClick"
                     TabCloseRequested="OnTabCloseRequested"
                     SelectionChanged="OnTabSelectionChanged"
                     CanReorderTabs="True" CanDragTabs="False">
                <TabView.TabStripFooter>
                    <Grid x:Name="DragRegion" MinWidth="80" Height="40" Background="Transparent" />
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <!-- App-level notices get their own row so they never cover the viewer toolbar. -->
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" Margin="12,4,12,0" />

        <Grid x:Name="ContentHost" Grid.Row="2">
            <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Leaf" Style="{ThemeResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="A light, fast PDF reader." Style="{ThemeResource BodyTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.8" />
                <Button Content="Open a PDF  (Ctrl+O)" Click="OnOpenClick" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                <TextBlock Text="or drop a file anywhere in this window" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <ContentPresenter x:Name="TabContent" />
        </Grid>
    </Grid>
</Window>
